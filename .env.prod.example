# Copier ce fichier en .env (à côté de docker-compose.prod.yml) et ajuster
# les valeurs. .env n'est pas commité (voir .gitignore).

# Domaine du site (le plugin) — DNS + ports 80/443 redirigés vers ce
# serveur (voir docs/self-hosting-docker.md).
DOMAIN=sidiscm-test.flye.fr

# Domaine de la boîte Mailpit (tous les e-mails du test y atterrissent,
# rien n'est réellement envoyé aux bêta-testeurs). Sous-domaine distinct,
# même serveur — ajouter l'enregistrement DNS correspondant.
MAIL_DOMAIN=mail.sidiscm-test.flye.fr

# Utilisateur pour accéder à Mailpit (protège les liens de connexion et le
# contenu des e-mails, le domaine étant public). Le mot de passe (hash
# bcrypt) se configure directement dans le Caddyfile, pas ici — voir les
# instructions dans le Caddyfile.
MAILPIT_BASIC_AUTH_USER=beta

# E-mail utilisé par Let's Encrypt pour les notifications de certificat.
ACME_EMAIL=admin@flye.fr

# Base de données — mots de passe forts, différents de ceux du dev local.
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-strong-root-password
