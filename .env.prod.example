# Copier ce fichier en .env (à côté de docker-compose.prod.yml) et ajuster
# les valeurs. .env n'est pas commité (voir .gitignore).
#
# Reverse proxy / HTTPS gérés en dehors de ce projet (Nginx Proxy
# Manager) : ce compose expose WordPress sur le port hôte 8085 et Mailpit
# sur 8086. Créer dans Nginx Proxy Manager un Proxy Host par service, vers
# ce serveur sur ces ports (avec certificat Let's Encrypt côté NPM, et
# idéalement un contrôle d'accès sur le Proxy Host de Mailpit puisque tous
# les e-mails des bêta-testeurs — dont leurs liens de connexion — y
# atterrissent).

# Base de données — mots de passe forts, différents de ceux du dev local.
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-strong-root-password
