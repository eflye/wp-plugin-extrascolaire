# Analyse statique du code de l'extension (niveau 5 depuis le 27/10/2026 ;
# les constats antérieurs non corrigés sont figés dans phpstan-baseline.neon,
# à réduire au fil des chantiers, jamais à étendre). Le cœur de WordPress n'est pas chargé : ses signatures
# proviennent des stubs de szepeviktor/phpstan-wordpress, et les
# constantes d'environnement du bootstrap ci-dessous.
includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - includes
    excludePaths:
        analyse:
            # Bibliothèque tierce embarquée (génération des PDF de
            # factures), déjà exclue du lint : elle n'est pas du code que
            # nous maintenons. Elle reste SCANNÉE (et non analyseAndScan)
            # pour que la classe FPDF soit connue des fichiers de
            # includes/ qui l'utilisent.
            - includes/fpdf
    bootstrapFiles:
        - phpstan-bootstrap.php
