{
	email {$ACME_EMAIL}
}

# Site principal — le plugin.
{$DOMAIN} {
	encode gzip
	reverse_proxy wordpress:80
}

# Boîte aux lettres de test (Mailpit) — protégée par mot de passe, car
# tous les e-mails des bêta-testeurs (dont leurs liens de connexion) y
# atterrissent et le domaine est public.
#
# Remplacer REMPLACER_PAR_LE_HASH_BCRYPT ci-dessous par le résultat de :
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'CHOISIR-UN-MOT-DE-PASSE'
# (coller le hash tel quel, avec ses $ — ne pas le mettre dans .env, un
# hash bcrypt contient des $ qui compliqueraient inutilement l'interpolation
# de docker compose).
{$MAIL_DOMAIN} {
	encode gzip
	basic_auth {
		{$MAILPIT_BASIC_AUTH_USER} REMPLACER_PAR_LE_HASH_BCRYPT
	}
	reverse_proxy mailpit:8025
}
